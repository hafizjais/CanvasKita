# Copy to .env.local for local development, and add the same variables in your
# hosting provider's dashboard for production. Never commit real values.

# Production URL without a trailing slash. Enables canonical URLs, the sitemap
# and search-engine indexing. Leave empty on preview environments.
NEXT_PUBLIC_SITE_URL=

# --- Enquiry form delivery (choose ONE option) -------------------------------

# Where enquiries are sent (used by options 1 and 2). Comma-separate multiple
# addresses.
ENQUIRY_TO_EMAIL=
# Optional sender, e.g. "Hafiz MJ Digital <hello@yourdomain.com>". For SMTP it
# must be the SMTP_USER mailbox; for Resend, an address on a verified domain.
ENQUIRY_FROM_EMAIL=

# Option 1: SMTP, e.g. a Hostinger Email mailbox. Set SMTP_PASS only in the
# hosting dashboard, never in a committed file.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Option 2: email via Resend (https://resend.com)
RESEND_API_KEY=

# Option 3: POST the enquiry as JSON to a webhook (Make, Zapier, n8n,
# Google Apps Script, etc.). Used only when neither email option is configured.
ENQUIRY_WEBHOOK_URL=

# --- Analytics (optional) ------------------------------------------------------

# Plausible-compatible, cookie-free analytics. Set to your site's domain,
# e.g. "hafizmjdigital.com". Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only change this for a self-hosted or proxied Plausible script.
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
