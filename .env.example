# Copy to .env.local for local development, and add the same variables in your
# hosting provider's dashboard for production. Never commit real values.

# Production URL without a trailing slash. Enables canonical URLs, the sitemap
# and search-engine indexing. Leave empty on preview environments.
NEXT_PUBLIC_SITE_URL=

# --- Enquiry form delivery (choose ONE option) -------------------------------

# Option 1: email via Resend (https://resend.com)
RESEND_API_KEY=
# Where enquiries are sent. Comma-separate multiple addresses.
ENQUIRY_TO_EMAIL=
# Sender address on a domain you've verified in Resend, e.g.
# "Hafiz MJ Digital <enquiries@yourdomain.com>". Without a verified domain,
# Resend only delivers test emails to your own account address.
ENQUIRY_FROM_EMAIL=

# Option 2: POST the enquiry as JSON to a webhook (Make, Zapier, n8n,
# Google Apps Script, etc.). Used only when Resend isn't configured.
ENQUIRY_WEBHOOK_URL=

# --- Analytics (optional) ------------------------------------------------------

# Plausible-compatible, cookie-free analytics. Set to your site's domain,
# e.g. "hafizmjdigital.com". Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Only change this for a self-hosted or proxied Plausible script.
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
